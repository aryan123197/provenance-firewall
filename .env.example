# Copy to .env or set these as secrets in your host. Never commit real values.
# The README's "Server configuration" table explains each one.

# --- Operator access -------------------------------------------------------
# Required to approve, reject, edit the registry, activate policies or run the demo.
OPERATOR_TOKEN=
# 1 lets anyone do those things. Only for a public demo on simulated or sandbox money.
OPEN_OPERATOR=

# --- Keys ------------------------------------------------------------------
# Shared between the firewall and the PayPal adapter. A random per-process value is used when unset.
AUTHORITY_KEY=
# Base64 PKCS8 Ed25519 key for signing the audit log (generate one with `pnpm gen:audit-key`).
# Without it, entries after a restart are signed with a new key.
AUDIT_SIGNING_KEY=

# --- PayPal (sandbox only) -------------------------------------------------
# Setting the first two switches the server from simulated to the PayPal sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From `pnpm register:webhook <https-url>`; needed to verify webhook signatures.
PAYPAL_WEBHOOK_ID=
# For `pnpm e2e` and the invoice scripts: a sandbox personal account that receives payouts,
# and the sandbox business account that issues the demo invoices.
PFW_DEMO_RECEIVER=
PFW_INVOICER_EMAIL=

# --- Claude (policy compiler and live agent) ------------------------------
ANTHROPIC_API_KEY=
# Hard cap on Claude API calls per UTC day. Default 300.
LLM_DAILY_CALLS=
# Defaults to claude-opus-5-5.
PFW_MODEL=

# --- Server ----------------------------------------------------------------
PORT=3000
DATABASE_PATH=data/pfw.db
POLICY_PATH=policies/default.policy.yaml
# JSON file { vendors, purchaseOrders } loaded at start.
REGISTRY_PATH=
# 1 seeds demo vendors and mounts the scenario runner.
DEMO_MODE=
# Requests per minute per client IP (0 turns it off), and TRUST_PROXY=1 behind a proxy such as Render.
RATE_LIMIT_PER_MIN=240
TRUST_PROXY=

{
  "name": "provenance-firewall",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "typecheck": "tsc --noEmit && pnpm --filter @pfw/dashboard typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test",
    "e2e": "tsx scripts/e2e.ts",
    "harness": "tsx scripts/harness.ts",
    "start": "tsx packages/server/src/main.ts",
    "dev:demo": "DEMO_MODE=1 OPEN_OPERATOR=1 DATABASE_PATH=:memory: tsx packages/server/src/main.ts",
    "build": "pnpm --filter @pfw/dashboard build",
    "gen:audit-key": "tsx scripts/gen-audit-key.ts",
    "harness:llm": "tsx scripts/harness-llm.ts",
    "seed:invoices": "tsx scripts/seed-invoices.ts",
    "demo:invoices": "tsx scripts/demo-invoices.ts",
    "verify:audit": "tsx scripts/verify-audit.ts",
    "register:webhook": "tsx scripts/register-webhook.ts",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@pfw/adapter": "workspace:*",
    "@pfw/core": "workspace:*",
    "@pfw/firewall": "workspace:*",
    "@pfw/harness": "workspace:*",
    "@pfw/llm": "workspace:*",
    "@pfw/server": "workspace:*",
    "@pfw/store": "workspace:*",
    "tsx": "^4.23.15"
  }
}

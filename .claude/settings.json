{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-precommit-hook.sh",
            "statusMessage": "Running pre-commit checks..."
          }
        ]
      }
    ]
  }
}
